# Beta Environment Configuration
# Copy this file to .env.beta and fill in your values
# cp .env.beta.example .env.beta

# Database (Beta Local - uses docker-compose.beta.yml)
DATABASE_URL="postgresql://node_user_beta:node_password_beta@localhost:5434/node_db_beta"

# Server Configuration
PORT=4001
NODE_ENV=development
FRONTEND_URL="http://localhost:3001"

# Authentication
# Use same Clerk keys or create separate beta Clerk app
CLERK_SECRET_KEY=your_clerk_secret_key_here
CLERK_WEBHOOK_SECRET=your_webhook_secret_here

# JWT (if using JWT auth)
JWT_SECRET=your_jwt_secret_here_beta

# OpenAI API Key
OPENAI_API_KEY=your_openai_api_key_here
